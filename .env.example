# =====================================================================
# NiyamAI Environment Configuration
# Copy this file to .env and insert your real API credentials.
# NEVER commit the .env file with actual credentials into git!
# =====================================================================

# TinyFish API Key (Required for live Search and Fetch)
# Obtain from: https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Optional: Google Gemini API Key for Semantic Extraction
# If omitted, NiyamAI automatically uses deterministic regex/NLP extraction fallback.
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=

# SQLite Database File Path
NIYAMAI_DB_PATH=niyamai.db

# TinyFish Search Location and Language
TINYFISH_LOCATION=IN
TINYFISH_LANGUAGE=en
